        {
            "label": "Run Current Python File in Docker",
            "type": "shell",
            "command": "$rel = '${relativeFile}'.Replace('\\', '/'); docker compose -f docker-compose.pyspark.yml run --rm pyspark-runner python \"/workspace/$rel\"",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            },
